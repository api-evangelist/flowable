            "name": "Get engine info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/flowable-rest/service/management/engine",
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Get engine info"
        },
        {
          "info": {
