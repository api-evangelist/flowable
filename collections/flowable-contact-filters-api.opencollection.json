{
  "opencollection": "1.0.0",
  "info": {
    "name": "Flowable REST Access Tokens Contact Filters API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Contact Filters",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List contact filters",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/flowable-rest/service/contact-filters",
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "List contact filters"
        },
        {
          "info": {
            "name": "Returns a paged list of users (contacts)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/flowable-rest/service/contact-filters/:contactFilterId",
            "params": [
              {
                "name": "contactFilterId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of contact filter"
              },
              {
                "name": "searchText",
                "value": "",
                "type": "query",
                "description": "Text to search for"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "\"The optional size of results to be returned, defaults to a configurable value (usually 100)"
              },
              {
                "name": "start",
                "value": "",
                "type": "query",
                "description": "The optional start (0 based) to return results from, defaults to 0."
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Returns a paged list of users (contacts)"
        }
      ]
    }
  ],
  "bundled": true
}